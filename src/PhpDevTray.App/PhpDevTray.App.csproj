<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PhpDevTray</AssemblyName>
    <ApplicationIcon>$(MSBuildProjectDirectory)\obj\branding\App.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <Page Remove="Assets/AppLogo.xaml" />
    <EmbeddedResource Include="Assets/AppLogo.xaml" LogicalName="PhpDevTray.App.Assets.AppLogo.xaml" />
    <Resource Include="$(ApplicationIcon)" LogicalName="Assets/App.ico" />
    <ProjectReference Include="../PhpDevTray.Core/PhpDevTray.Core.csproj" />
    <ProjectReference Include="../PhpDevTray.Infrastructure/PhpDevTray.Infrastructure.csproj" />
  </ItemGroup>
  <Target Name="GenerateApplicationIcon" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)\Assets\AppLogo.xaml;$(MSBuildProjectDirectory)\..\..\scripts\new-app-icons.ps1"
          Outputs="$(ApplicationIcon)">
    <Exec Command="powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\new-app-icons.ps1&quot; -IconPath &quot;$(ApplicationIcon)&quot;" />
    <ItemGroup><FileWrites Include="$(ApplicationIcon)" /></ItemGroup>
  </Target>
</Project>
